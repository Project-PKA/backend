# =============================================================================
# Modelo do `.env` da VPS (um por ambiente, em /srv/pokemon-auction/<ambiente>/.env).
# Copie para a VPS, preencha, `chmod 600` e NUNCA commite o arquivo preenchido.
# Segredos que entram em URL (senhas do banco e do Redis): `openssl rand -hex 32` (só 0-9a-f; base64
# tem `/` e `+`, que quebram a URL de conexão). Os demais: `openssl rand -base64 48`.
# Nomes e origem de cada um: docs/secrets.md
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
# dev | homolog | prod. Atenção: homolog e prod exigem um provedor de e-mail real (EMAIL_PROVIDER
# diferente de `log`) e REDIS_URL; a API se recusa a subir sem eles (decisão D1 em shared/OWNER.md).
APP_ENV=dev
APP_DOMAIN=api.exemplo.com.br
APP_PUBLIC_URL=https://app.exemplo.com.br
CORS_ORIGINS=https://app.exemplo.com.br
EMAIL_PROVIDER=log
LOG_LEVEL=info

# --- Banco -------------------------------------------------------------------
DB_NAME=app
DB_OWNER_USER=owner
DB_OWNER_PASSWORD=
# Senha do papel de login da API (app_api, sem BYPASSRLS). 24+ caracteres.
DB_APP_PASSWORD=

# --- Redis (BullMQ: sync do catálogo e virada dos leilões) --------------------
REDIS_PASSWORD=

# --- Autenticação ---------------------------------------------------------------
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=
OTP_HASH_SECRET=

# --- Backup (deploy/backup.sh) ------------------------------------------------
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14
