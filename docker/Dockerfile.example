# syntax=docker/dockerfile:1
#
# Dockerfile multi-stage, esqueleto agnóstico de linguagem.
#
# Como usar (docker/README.md):
#   cp docker/Dockerfile.example Dockerfile
#   e troque cada TODO(bootstrap) pelos equivalentes da stack em STACK.md.
#
# Regras que valem para qualquer stack:
#   - Build e runtime separados: a imagem final não leva compilador nem
#     dependência de desenvolvimento.
#   - Roda como usuário não-root.
#   - Configuração vem do ambiente em RUNTIME (variáveis do GitHub
#     Environment), nunca gravada na imagem: a mesma imagem vai de dev a prod.
#   - O .dockerignore da raiz impede que .env, .git e coverage entrem aqui.

##############################
# Stage 1: build
##############################
# TODO(bootstrap): imagem base de build da stack. Exemplos:
#   Node/TS     -> node:22-alpine
#   Python      -> python:3.13-slim
#   Go          -> golang:1.24-alpine
#   Java/Kotlin -> eclipse-temurin:21-jdk-alpine
#   C#/.NET     -> mcr.microsoft.com/dotnet/sdk:9.0
FROM TODO-imagem-de-build AS build

WORKDIR /app

# Copie primeiro só os manifestos de dependência, para o cache do Docker
# reaproveitar a instalação quando só o código mudar.
# TODO(bootstrap): ex.: COPY package.json package-lock.json ./  |  COPY pyproject.toml uv.lock ./  |  COPY go.mod go.sum ./
COPY TODO-manifestos ./

# TODO(bootstrap): instalação de dependências. Ex.:
#   npm ci  |  uv sync --frozen --no-dev  |  go mod download  |  ./gradlew dependencies
RUN TODO-instalar-dependencias

COPY . .

# TODO(bootstrap): build. Ex.:
#   npm run build  |  go build -o /out/api ./cmd/api  |  ./gradlew bootJar  |  dotnet publish -c Release -o /out
RUN TODO-build

##############################
# Stage 2: runtime
##############################
# TODO(bootstrap): a menor imagem que roda o artefato. Exemplos:
#   Node/TS     -> node:22-alpine
#   Python      -> python:3.13-slim
#   Go          -> gcr.io/distroless/static-debian12:nonroot
#   Java/Kotlin -> eclipse-temurin:21-jre-alpine
#   C#/.NET     -> mcr.microsoft.com/dotnet/aspnet:9.0
FROM TODO-imagem-de-runtime AS runtime

WORKDIR /app

# TODO(bootstrap): copie só o artefato. Ex.: COPY --from=build /app/dist ./dist
COPY --from=build /app/TODO-artefato ./

# Usuário não-root. Imagens distroless ":nonroot" já trazem um; nas demais:
#   alpine  -> RUN adduser -D -u 10001 app
#   debian  -> RUN useradd -r -u 10001 app
USER 10001

EXPOSE 8080

# Health check do orquestrador usa GET /health (ARCHITECTURE.md).
# TODO(bootstrap): comando de start. Ex.:
#   ["node", "dist/main.js"]  |  ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]  |  ["/app/api"]
CMD ["TODO-comando-de-start"]
