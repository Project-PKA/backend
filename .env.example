# =============================================================================
# Variáveis de ambiente — copie para `.env` e ajuste. Nunca commite o .env real.
#
# Regras que não dependem da stack:
#
#  1. A configuração chega em RUNTIME. A mesma imagem roda em dev, test,
#     homolog e prod; o que muda são estas variáveis, vindas do GitHub
#     Environment no deploy. Nada disto entra na imagem.
#  2. Toda variável nova fica em TRÊS lugares: aqui, na leitura validada de
#     ambiente do código (falhe no boot se faltar), e nas variables/secrets
#     do GitHub Environment.
#  3. Segredo real nunca aparece aqui: só o nome e um valor de desenvolvimento.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# Ambiente lógico: local | dev | test | homolog | prod
APP_ENV=local
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# --- Banco de dados ----------------------------------------------------------
# TODO(bootstrap): ajuste o driver/formato da URL ao banco escolhido em STACK.md.
# Fora do compose o host é localhost; dentro do compose.yaml é "db".
DATABASE_URL=postgresql://app:app@localhost:5432/app
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
DB_PORT=5432

# --- Observabilidade ---------------------------------------------------------
OTEL_SERVICE_NAME=api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# Somente CI/CD — configurados como Secrets/Variables do GitHub, nunca aqui.
# Nomes canônicos: CONVENCOES.md do codex-base, seção 11.
#
# AUTOMATION_TOKEN       (secret, org)         Project, release, PR de contrato
# SONAR_TOKEN            (secret, org)         SonarCloud
# PROJECT_URL            (variable, org)       GitHub Project
# CONTRACT_REPO          (variable, org)       org/repo do docs/shared
# CODEQL_LANGUAGES       (variable, repo)      linguagem(ns) do CodeQL
# APP_BASE_URL           (variable, environment) smoke test do deploy
# -----------------------------------------------------------------------------
