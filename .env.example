# =============================================================================
# Variáveis de ambiente — copie para `.env` e ajuste. Nunca commite o .env real.
#
# Regras que não dependem da stack:
#
#  1. A configuração chega em RUNTIME. A mesma imagem roda em dev, test,
#     homolog e prod; o que muda são estas variáveis, vindas do GitHub
#     Environment no deploy. Nada disto entra na imagem.
#  2. Toda variável nova fica em TRÊS lugares: aqui, na leitura validada de
#     ambiente do código (falhe no boot se faltar), e nas variables/secrets
#     do GitHub Environment.
#  3. Segredo real nunca aparece aqui: só o nome e um valor de desenvolvimento.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# Ambiente lógico: local | dev | test | homolog | prod
APP_ENV=local
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# --- Banco de dados ----------------------------------------------------------
# PostgreSQL (STACK.md, seção 3). Dois papéis, de propósito (ADR 0011):
#   DATABASE_URL            a API em execução: papel app_api, SEM BYPASSRLS. É ele
#                           que sofre o RLS. Crie com `npm run db:provision-dev`.
#   MIGRATION_DATABASE_URL  o dono do schema: migrations, seed e db:create-admin.
#                           Nunca é usado pela API em execução.
# Fora do compose o host é localhost; dentro do compose.yaml é "db".
DATABASE_URL=postgresql://app_api:app_api@localhost:5432/app
MIGRATION_DATABASE_URL=postgresql://app:app@localhost:5432/app
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
DB_PORT=5432

# --- Fila e jobs -------------------------------------------------------------
# Redis do BullMQ (sync noturno do catálogo às 03:00). Opcional em desenvolvimento
# (sem ele não há jobs; rode `npm run catalog:sync` na mão); OBRIGATÓRIO em homolog e
# prod. Suba com `docker compose up -d redis`.
REDIS_URL=redis://:app@localhost:6379
# Idiomas do catálogo, o primeiro é o canônico (en e pt por padrão).
# CATALOG_LANGUAGES=en,pt

# --- Autenticação ------------------------------------------------------------
# Valores DE DESENVOLVIMENTO (32+ caracteres). Em homolog e prod vêm do GitHub
# Environment (docs/secrets.md), nunca daqui: troque por valores gerados.
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me-0123456789
REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-change-me-0123456789
OTP_HASH_SECRET=dev-only-otp-hash-secret-change-me-0123456789
# ACCESS_TOKEN_TTL_SECONDS=900   REFRESH_TOKEN_TTL_DAYS=30   INVITATION_TTL_DAYS=7
# OTP_TTL_SECONDS=600   OTP_MAX_ATTEMPTS=5   OTP_RESEND_SECONDS=60

# Provedor de e-mail: "log" imprime o código no log (SÓ desenvolvimento). A API
# se recusa a subir com "log" em homolog e prod.
EMAIL_PROVIDER=log
# URL pública do frontend, usada nos links de convite.
APP_PUBLIC_URL=http://localhost:3000

# --- Rede e segurança --------------------------------------------------------
# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula. Vazio
# = nenhuma. Nunca "*".
CORS_ORIGINS=http://localhost:3000
# Atrás de reverse proxy (produção), ative para o IP real vir de X-Forwarded-For;
# sem isso o limite de requisições enxerga só o IP do proxy.
TRUST_PROXY=false
# Limites de requisição (valores padrão). Corpo grande e requisição lenta são recusados.
# BODY_LIMIT_BYTES=262144   REQUEST_TIMEOUT_MS=30000   HANDLER_TIMEOUT_MS=20000
# INVITATION_RESEND_SECONDS=60
# RATE_LIMIT_PER_MINUTE=120   RATE_LIMIT_OTP_REQUEST_PER_MINUTE=5   RATE_LIMIT_OTP_VERIFY_PER_MINUTE=10
# RATE_LIMIT_SHOWCASE_PER_MINUTE=30   (vitrine pública, por IP)
# RATE_LIMIT_ACCESS_REQUEST_PER_MINUTE=3   (pedido de acesso da landing, por IP)
# RATE_LIMIT_PUBLIC_PER_MINUTE=20   (rotas públicas por link; o banco ainda bloqueia o IP após 20 falhas)

# --- Observabilidade ---------------------------------------------------------
OTEL_SERVICE_NAME=api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# Somente CI/CD — configurados como Secrets/Variables do GitHub, nunca aqui.
# Nomes canônicos: CONVENCOES.md do codex-base, seção 11.
#
# AUTOMATION_TOKEN       (secret, org)         Project, release, PR de contrato
# SONAR_TOKEN            (secret, org)         SonarCloud
# PROJECT_URL            (variable, org)       GitHub Project
# CONTRACT_REPO          (variable, org)       org/repo do docs/shared
# CODEQL_LANGUAGES       (variable, repo)      linguagem(ns) do CodeQL
# APP_BASE_URL           (variable, environment) smoke test do deploy
# -----------------------------------------------------------------------------
